# Keep shareable VS Code workspace config in git
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/extensions.json

# Other editor-local settings
.idea/
*.code-workspace

# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini

# Local environment and machine-specific config
.env
.env.*
!.env.example
!.env.sample
*.local

# Runtime logs and temporary files
*.log
*.log.*
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
error_log
php_errors.log

# Local PHP runtime artifacts generated by contact-handler.php
/contact-log.txt
/rate-limit.log

# Claude Code — celý adresár je lokálny
.claude/

# FontAwesome — loaded via CDN, not committed
fontawesome-free-7.1.0-web/

# Trunk — runtime and downloaded files, regenerated automatically
.trunk/actions/
.trunk/logs/
.trunk/notifications/
.trunk/out/
.trunk/plugins/
.trunk/tmp/
.trunk/tools/

# Citlivé súbory
config.php
*.pem
*.key
*.p12
*.pfx

# Lokálne PHP dev nástroje (stiahne tools/install-dev-tools.ps1) — NEdeployovať
tools/*.phar
.php-cs-fixer.cache
.phpstan.cache/
